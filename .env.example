# URL pública del sitio (sin barra final). Usada en canonicals, sitemap y OG.
NEXT_PUBLIC_SITE_URL=https://nitidflow.com

# Endpoint que recibe los leads del formulario (webhook n8n).
# El valor real vive en Bitwarden y se configura en Netlify > Environment variables.
# NUNCA commitear el valor real en este repositorio.
LEAD_WEBHOOK_URL=

# Opcional: cabecera de autenticación para el webhook, si el endpoint la exige.
LEAD_WEBHOOK_TOKEN=
